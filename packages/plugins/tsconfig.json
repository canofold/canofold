{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@canofold/markdown": ["../markdown/src/index.ts"],
      "@canofold/markdown/server": ["../markdown/src/server.ts"],
      "@canofold/markdown/*": ["../markdown/src/*"],
      "canofold": ["../canofold/src/index.ts"]
    }
  }
}
