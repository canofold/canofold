{
  "name": "@canofold/markdown",
  "version": "0.2.0",
  "description": "An interactive, themeable Markdown renderer for knowledge and documentation sites.",
  "license": "MIT",
  "author": "Canofold Contributors",
  "homepage": "https://docfuse.dev/markdown/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canofold/docfuse.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/canofold/docfuse/issues"
  },
  "keywords": [
    "markdown",
    "documentation",
    "renderer",
    "interactive",
    "shiki"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/analyze": {
      "types": "./dist/server/analyze.d.ts",
      "import": "./dist/server/analyze.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && vite build -c vite.client.config.ts && tsc -p tsconfig.build.json && tailwindcss -i ./src/tailwind.css -o ./dist/base.css --minify && node scripts/build-css.mjs",
    "test:browser": "node scripts/test-browser-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/markdown"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.34.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-definition-list": "^2.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/unist": "^3.0.3",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
