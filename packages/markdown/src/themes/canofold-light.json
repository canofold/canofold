{
  "$schema": "vscode://schemas/color-theme",
  "name": "canofold-light",
  "displayName": "Canofold Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#F0F2F5",
    "editor.foreground": "#344054"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#505B70", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#62419E" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#1F6D2E" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#8C4C0F" }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"],
      "settings": { "foreground": "#1459AD" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#17666B" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable.name"],
      "settings": { "foreground": "#344054" }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#88366D" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag.sgml", "punctuation.definition.tag"],
      "settings": { "foreground": "#9D3329" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#8C4C0F" }
    },
    {
      "scope": ["string.regexp", "source.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#9D3329" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#475467" }
    },
    {
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#1F6D2E" }
    },
    {
      "scope": ["markup.deleted", "punctuation.definition.deleted", "invalid", "message.error"],
      "settings": { "foreground": "#9D3329" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#1459AD", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#344054", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#344054", "fontStyle": "italic" }
    }
  ]
}
