{
  "name": "canofold",
  "version": "0.2.0",
  "description": "A static-first, minimally invasive knowledge and documentation platform for Markdown, MDX, search, and AI-ready output.",
  "license": "MIT",
  "author": "Canofold Contributors",
  "homepage": "https://canofold.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canofold/docfuse.git",
    "directory": "packages/canofold"
  },
  "bugs": {
    "url": "https://github.com/canofold/docfuse/issues"
  },
  "keywords": [
    "docs",
    "documentation",
    "static-site",
    "cli",
    "mdx",
    "markdown",
    "ai",
    "multilingual"
  ],
  "type": "module",
  "bin": {
    "canofold": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.css",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/render/styles.input.css','dist/styles.input.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. build && vitest run --root ../.."
  },
  "dependencies": {
    "@canofold/markdown": "workspace:*",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/semver": "^7.8.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  }
}
